
<header
  class="sticky top-0 z-[10] bg-white/90 px-[30px] py-5 backdrop-blur"
  x-data="{ open: false, pages: false }"
  @keydown.escape="pages = false; open = false"
>
  <div class="mx-auto w-full max-w-site">
    <div class="flex w-full items-center justify-between">
      <div class="flex items-center gap-2.5">
        <a href="#top" class="flex items-center gap-2.5" aria-label="Datem home">
          <img src="/images/datemlogo.png" width="42" alt="Datem logo" />
          <span class="text-h6 font-extrabold tracking-[-.02em]">Datem</span>
        </a>
      </div>

      <nav class="hidden items-center gap-8 lg:flex">
        <a href="#top" class="text-b18 text-ink transition hover:text-brand">Home</a>
        <a href="#about" class="text-b18 text-ink transition hover:text-brand">Why Us</a>
        <a href="#services" class="text-b18 text-ink transition hover:text-brand">Services</a>
        
        <a href="#contact" class="text-b18 text-ink transition hover:text-brand">Contact</a>
       
      </nav>

      <div class="flex items-center gap-5">
        <a href="/users/log-in" class="hidden text-b18 font-medium transition hover:text-brand lg:block">Login</a>
        <a
          href="#register"
          class="group hidden items-center gap-2.5 overflow-hidden rounded-[10px] bg-brand px-6 py-3.5 text-b18 font-medium text-white transition hover:bg-ink lg:flex"
        >
          Register entry
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="7" y1="17" x2="17" y2="7" />
            <polyline points="7 7 17 7 17 17" />
          </svg>
        </a>
        <button type="button" class="rounded-lg p-2 lg:hidden">
          <span class="sr-only">Toggle navigation menu</span>
          <svg x-show="!open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
          <svg x-show="open" x-cloak class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
    </div>

    <nav x-show="open" x-cloak x-collapse @click="open = false" class="mt-4 flex flex-col rounded-2xl bg-n2 p-5 lg:hidden">
      <a href="#top" class="py-2.5 text-b18">Home</a>
      <a href="#about" class="py-2.5 text-b18">Why Us</a>
      <a href="#services" class="py-2.5 text-b18">Services</a>
      <a href="#register" class="py-2.5 text-b18">Register Entry</a>
      <a href="#contact" class="py-2.5 text-b18">Contact</a>
      <a href="#register" class="mt-3 rounded-[10px] bg-brand px-6 py-3 text-center text-b18 font-medium text-white">Register entry to a location</a>
    </nav>
  </div>
</header>

<main id="top">

  <section class="overflow-hidden bg-lilac/60 px-[30px] py-[120px]">
    <div class="mx-auto flex w-full max-w-site flex-col items-center justify-between gap-16 lg:flex-row">
      <div class="w-full lg:w-[44%]">
        <h1 class="reveal relative m-0 text-[36px] font-semibold leading-[110%] tracking-[-1px] sm:text-[56px] lg:text-h1 lg:tracking-[-4px]">
          Smart, Secure,
          <span class="marker"><span>Seamless</span></span> Visitor Access
        </h1>
        <p class="reveal mb-[53px] mt-[42px] text-b20 lg:pr-[100px]">
          Securely streamline visitor check-ins with our digital visitor
          management solution, for enhanced efficiency and safety.
        </p>
        <a
          href="#register"
          class="reveal group flex h-[70px] w-fit items-center gap-2.5 rounded-[10px] bg-brand px-8 text-b18 font-medium text-white transition hover:bg-ink"
        >
          Register an entry
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="7" y1="17" x2="17" y2="7" />
            <polyline points="7 7 17 7 17 17" />
          </svg>
        </a>
        <p class="reveal mt-5 text-b16">
          Already have an account?
          <a href="users/log_in" class="font-semibold text-brand hover:underline">Log In now</a>
        </p>
      </div>

      <div class="relative w-full lg:w-[52%]">
        <div class="rounded-[20px] bg-brand/10 p-6 lg:p-10">
          <img
            src="/images/police.jpg"
            alt="Security guard checking in a visitor at a facility"
            class="reveal w-full rounded-[20px] object-cover shadow-hero"
          />
        </div>
        <div class="reveal absolute -bottom-6 left-6 flex items-center gap-3 rounded-2xl bg-white px-5 py-3 shadow-lift">
          <div class="flex -space-x-3">
            <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=120&q=80" alt="" loading="lazy" class="h-10 w-10 rounded-full border-2 border-white object-cover" />
            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=120&q=80" alt="" loading="lazy" class="h-10 w-10 rounded-full border-2 border-white object-cover" />
            <img src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?w=120&q=80" alt="" loading="lazy" class="h-10 w-10 rounded-full border-2 border-white object-cover" />
          </div>
          <span class="text-b16 font-semibold">Front desks checking in now</span>
        </div>
      </div>
    </div>
  </section>

  <section class="px-[30px] py-[60px]">
    <div class="mx-auto w-full max-w-site">
      <p class="text-center text-b16">Trusted by facilities and organizations across Kenya.</p>
      <div class="mt-8 grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-5">
        <span class="text-center text-h6 font-bold text-[#b9b9c4]">GS1 Kenya</span>
        <span class="text-center text-h6 font-bold text-[#b9b9c4]">Vumbuzi AI</span>
        <span class="text-center text-h6 font-bold text-[#b9b9c4]">GHCE</span>
        <span class="text-center text-h6 font-bold text-[#b9b9c4]">Glocal Models</span>
        <span class="text-center text-h6 font-bold text-[#b9b9c4]">GS1 I-Hub</span>
      </div>
    </div>
  </section>


  <section id="services" class="px-[30px] pb-[120px]">
    <div class="mx-auto flex w-full max-w-site flex-col items-center gap-16">
      <h2 class="reveal relative w-full max-w-[610px] text-center text-[36px] font-medium leading-[110%] tracking-[-.02px] sm:text-[48px] lg:text-h3">
        Where security meets
        <span class="marker"><span>smarter</span></span> access
      </h2>

      <div class="flex w-full flex-col gap-4">
        <div class="flex flex-col gap-4 lg:flex-row">
          <article class="reveal flex w-full flex-col gap-12 overflow-hidden rounded-[30px] bg-n2 px-12 pt-12 lg:w-[62%]">
            <div class="flex flex-col gap-3">
              <h3 class="text-h5 font-medium">Digital visitor check-in</h3>
              <p class="text-b18 opacity-80">
                Replace the paper logbook with a fast, digital sign-in that
                keeps an accurate record of every guest on site.
              </p>
            </div>
            <img src="https://vizito.eu/images/blog/reception-check-in.webp?width=1100" alt="Front desk staff checking in a visitor" loading="lazy" class="-mb-14 h-[280px] w-full rounded-t-[20px] object-cover" />
          </article>
          <article class="reveal flex w-full flex-col gap-10 overflow-hidden rounded-[30px] bg-n2 px-12 pb-12 pt-8 lg:w-[37%]">
            <img src="https://www.hoyez.com/wp-content/uploads/2021/07/access-control-card-reader.jpg" alt="Access badge and ID verification" loading="lazy" class="h-[200px] w-full rounded-[20px] object-cover" />
            <div class="flex flex-col gap-3">
              <h3 class="text-h5 font-medium">Access Control</h3>
              <p class="text-b18 opacity-80">Grant, log, and revoke facility access in real time.</p>
            </div>
          </article>
        </div>

        <div class="flex flex-col gap-4 lg:flex-row">
          <article class="reveal relative flex w-full flex-col gap-1.5 overflow-hidden rounded-[30px] bg-n2 px-12 pt-12 lg:w-[37%]">
            <div class="flex flex-col gap-3">
              <h3 class="text-h5 font-medium">Visit Analytics</h3>
              <p class="text-b18 opacity-80">See visitor volume, peak hours, and dwell time at a glance.</p>
            </div>
            <img src="https://img.magnific.com/free-photo/hands-using-tablet-screen-showing-statistics-business-data_53876-42762.jpg?semt=ais_hybrid&w=740&q=80" alt="Visitor analytics dashboard" loading="lazy" class="-mb-14 mt-8 h-[240px] w-full rounded-t-[20px] object-cover" />
          </article>
          <article class="reveal flex w-full flex-col gap-10 overflow-hidden rounded-[30px] bg-n2 pl-12 pt-12 lg:w-[62%]">
            <div class="flex flex-col gap-3 pr-12">
              <h3 class="text-h5 font-medium">Compliance &amp; Data Protection</h3>
              <p class="text-b18 opacity-80">
                Keep detailed, auditable visitor records that support your
                organization's compliance and data-protection obligations.
              </p>
            </div>
            <img src="https://alphacap.co.ke/wp-content/uploads/KRA-audit.webp" alt="Team reviewing compliance records" loading="lazy" class="h-[260px] w-full rounded-tl-[20px] object-cover" />
          </article>
        </div>
      </div>
    </div>
  </section>


  <section class="px-[30px] pb-[120px]">
    <div class="mx-auto flex w-full max-w-site flex-col items-center gap-16">
      <h2 class="reveal relative w-full max-w-[650px] text-center text-[36px] font-medium leading-[110%] sm:text-[48px] lg:text-h3">
        3 step process to a
        <span class="marker"><span>secure</span></span> front desk
      </h2>

      <div class="grid w-full grid-cols-1 gap-6 md:grid-cols-3">
        <div class="reveal flex flex-col gap-20 rounded-[24px] bg-[#eff8ff] px-[35px] py-10">
          <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white text-brand">
            <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z" />
            </svg>
          </span>
          <div class="flex flex-col gap-6">
            <h3 class="text-h4 font-medium">Register the visit</h3>
            <p class="text-b18 opacity-80">Guests fill in a quick digital form, or your front desk registers them in seconds.</p>
            <a href="#register" class="flex items-center gap-2.5 text-b16 font-bold uppercase tracking-wide text-brand transition-all hover:gap-4">
              Read more
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="7" y1="17" x2="17" y2="7" />
                <polyline points="7 7 17 7 17 17" />
              </svg>
            </a>
          </div>
        </div>

        <div class="reveal flex flex-col gap-20 rounded-[24px] bg-[#ecae491a] px-[35px] py-10">
          <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white text-amber">
            <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </span>
          <div class="flex flex-col gap-6">
            <h3 class="text-h4 font-medium">Verify &amp; badge</h3>
            <p class="text-b18 opacity-80">Identity is verified and an access badge is issued for the duration of the visit.</p>
            <a href="#register" class="flex items-center gap-2.5 text-b16 font-bold uppercase tracking-wide text-brand transition-all hover:gap-4">
              Read more
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="7" y1="17" x2="17" y2="7" />
                <polyline points="7 7 17 7 17 17" />
              </svg>
            </a>
          </div>
        </div>

        <div class="reveal flex flex-col gap-20 rounded-[24px] bg-[#56c5901a] px-[35px] py-10">
          <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white text-[#2f9e6a]">
            <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3" />
            </svg>
          </span>
          <div class="flex flex-col gap-6">
            <h3 class="text-h4 font-medium">Track &amp; check out</h3>
            <p class="text-b18 opacity-80">Every entry and exit is logged automatically, giving you a complete, auditable record.</p>
            <a href="#register" class="flex items-center gap-2.5 text-b16 font-bold uppercase tracking-wide text-brand transition-all hover:gap-4">
              Read more
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="7" y1="17" x2="17" y2="7" />
                <polyline points="7 7 17 7 17 17" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

 
  <section id="about" class="px-[30px] pb-[120px]">
    <div class="mx-auto flex w-full max-w-site flex-col items-center gap-16">
      <h2 class="reveal relative w-full max-w-[650px] text-center text-[36px] font-medium leading-[110%] sm:text-[48px] lg:text-h3">
        Why facilities
        <span class="marker"><span>choose</span></span> Datem
      </h2>

      <div class="flex w-full flex-col items-center justify-between gap-12 lg:flex-row">
        <div class="reveal relative w-full rounded-[30px] bg-brand px-8 pb-24 pt-12 lg:w-[48%] lg:px-[50px] lg:pb-[110px] lg:pt-[60px]">
          <img src="https://secuviz.com/wp-content/uploads/2024/07/a5e9fe649de3aa0ec4e3c758591cfc54.png" alt="Security personnel monitoring visitor access" loading="lazy" class="w-full rounded-[20px] object-cover shadow-hero" />
        </div>

        <div class="flex w-full flex-col items-start gap-8 lg:w-[44%]">
          <div class="reveal flex gap-6">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-lilac text-b20 font-bold text-brand">1</span>
            <div class="flex w-[90%] flex-col gap-2">
              <h3 class="text-h4 font-medium">Faster front-desk check-ins</h3>
              <p class="text-b18 opacity-80">Cut queues and paperwork with a digital sign-in that takes seconds, not minutes.</p>
            </div>
          </div>
          <div class="reveal flex gap-6">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-lilac text-b20 font-bold text-brand">2</span>
            <div class="flex w-[90%] flex-col gap-2">
              <h3 class="text-h4 font-medium">Stronger facility security</h3>
              <p class="text-b18 opacity-80">Know exactly who is on site at any moment, with a full history of every visit.</p>
            </div>
          </div>
          <div class="reveal flex gap-6">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-lilac text-b20 font-bold text-brand">3</span>
            <div class="flex w-[90%] flex-col gap-2">
              <h3 class="text-h4 font-medium">Built for compliance</h3>
              <p class="text-b18 opacity-80">Data protection is built in from the start, so your visitor records stay secure and audit-ready.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS 
  <section id="testimonials" class="bg-n6 px-[30px] py-[120px]">
    <div class="mx-auto flex w-full max-w-site flex-col items-center gap-16">
      <h2 class="reveal relative w-full max-w-[650px] text-center text-[36px] font-medium leading-[110%] sm:text-[48px] lg:text-h3">
        What our satisfied
        <span class="marker"><span>facilities</span></span> say
      </h2>

      <div class="swiper testimonial-swiper w-full !px-1 !pb-16" phx-update="ignore" id="testimonial-swiper">
        <div class="swiper-wrapper">
          <figure class="swiper-slide !h-auto flex-col items-start gap-8 rounded-[20px] bg-white px-10 pb-[60px] pt-[54px] lg:pl-[45px]">
