 <section id="register" class="px-[30px] pb-[120px]">
  <div class="mx-auto flex w-full max-w-site flex-col items-center gap-16">
    <h2 class="reveal relative w-full max-w-[650px] text-center text-[36px] font-medium leading-[110%] sm:text-[48px] lg:text-h3">
      Get your <span class="marker"><span>digital entry pass</span></span> to your location
    </h2>

    {live_render(@conn, DatemWeb.RegisterEntryLive, id: "register-entry")}
  </div>
</section>
  <section id="platforms" class="px-[30px] pb-[120px]">
    <div class="mx-auto flex w-full max-w-site flex-col items-center gap-16">
      <h2 class="reveal relative w-full max-w-[610px] text-center text-[36px] font-medium leading-[110%] sm:text-[48px] lg:text-h3">
        Works with the tools your
        <span class="marker"><span>front desk</span></span> already uses
      </h2>

      <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="reveal flex flex-col gap-24 rounded-[20px] border border-[#e2e2e2] px-5 py-8 transition hover:bg-[#f7f7f9]">
          <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-lilac text-brand">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z" /></svg>
          </span>
          <div class="flex flex-col gap-4">
            <h3 class="text-h6 font-medium">Email Alerts</h3>
            <p class="text-b16 opacity-80">Get notified the moment a visitor checks in or out.</p>
          </div>
        </div>

        <div class="flex flex-col gap-4">
          <div class="reveal flex flex-1 gap-4 rounded-[20px] border border-[#e2e2e2] pb-7 pl-5 pr-4 pt-6 transition hover:bg-[#f7f7f9]">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-mintbg text-[#2f9e6a]">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z" /></svg>
            </span>
            <div class="flex flex-col gap-2">
              <h3 class="text-h6 font-medium">SMS Notifications</h3>
              <p class="text-b16 opacity-80">Host staff are texted when their guest arrives.</p>
            </div>
          </div>
          <div class="reveal flex flex-1 gap-4 rounded-[20px] border border-[#e2e2e2] pb-7 pl-5 pr-4 pt-6 transition hover:bg-[#f7f7f9]">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-honey/60 text-[#b7842a]">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
            </span>
            <div class="flex flex-col gap-2">
              <h3 class="text-h6 font-medium">Badge Printing</h3>
              <p class="text-b16 opacity-80">Print a visitor badge automatically at check-in.</p>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-4">
          <div class="reveal flex flex-1 gap-4 rounded-[20px] border border-[#e2e2e2] pb-7 pl-5 pr-4 pt-6 transition hover:bg-[#f7f7f9]">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-n2 text-ink">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 4.94-1.54 4.94-6.31a4.7 4.7 0 0 0-1.29-3.27 4.36 4.36 0 0 0-.08-3.3s-1.3-.39-4.3 1.61a10.3 10.3 0 0 0-5.5 0c-3-2-4.3-1.6-4.3-1.6a4.36 4.36 0 0 0-.08 3.29A4.7 4.7 0 0 0 3 9.21c0 4.73 1.8 5.92 4.94 6.31a3.37 3.37 0 0 0-.94 2.58V22" /></svg>
            </span>
            <div class="flex flex-col gap-2">
              <h3 class="text-h6 font-medium">API Access</h3>
              <p class="text-b16 opacity-80">Connect visitor data to your own internal systems.</p>
            </div>
          </div>
          <div class="reveal flex flex-1 gap-4 rounded-[20px] border border-[#e2e2e2] pb-7 pl-5 pr-4 pt-6 transition hover:bg-[#f7f7f9]">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-sky/70 text-[#2f6fbf]">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 10l4.55-2.27A1 1 0 0 1 21 8.62v6.76a1 1 0 0 1-1.45.89L15 14z" /><rect x="1" y="5" width="14" height="14" rx="2" /></svg>
            </span>
            <div class="flex flex-col gap-2">
              <h3 class="text-h6 font-medium">Reception Kiosk</h3>
              <p class="text-b16 opacity-80">A self-serve tablet check-in for a walk-up front desk.</p>
            </div>
          </div>
        </div>

        <div class="reveal flex flex-col gap-24 rounded-[20px] border border-[#e2e2e2] px-5 py-8 transition hover:bg-[#f7f7f9]">
          <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-lilac text-brand">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
          </span>
          <div class="flex flex-col gap-4">
            <h3 class="text-h6 font-medium">Access Control Systems</h3>
            <p class="text-b16 opacity-80">Integrate with your existing door and turnstile hardware.</p>
          </div>
        </div>
      </div>

      <a
        href="#platforms"
        class="reveal group flex items-center gap-2.5 rounded-[10px] bg-brand px-7 py-4 text-b18 font-medium text-white transition hover:bg-ink">
         View all integrations
         <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="7" y1="17" x2="17" y2="7" />
          <polyline points="7 7 17 7 17 17" />
        </svg>
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-[30px] pt-[80px]">
    <div class="mx-auto w-full max-w-site">
      <div class="relative flex flex-col items-center justify-between gap-8 overflow-hidden rounded-[28px] bg-lilac2 pl-8 pt-8 lg:flex-row lg:pl-[68px] lg:pt-[30px]">
        <div class="flex w-full flex-col items-start gap-8 pb-12 pr-8 lg:w-[58%] lg:pb-[68px] lg:pr-0">
          <h2 class="reveal m-0 text-[36px] font-semibold leading-[110%] tracking-[-.02em] sm:text-[48px] lg:text-h2">
            Ready to secure your organization?
          </h2>
          <p class="reveal text-b18">
            Get started for free and see how Datem streamlines visitor
            check-in and access management from day one.
          </p>
          <a
            href="#register"
            class="reveal group flex h-[70px] w-fit items-center gap-2.5 rounded-[10px] bg-brand px-8 text-b18 font-medium text-white transition hover:bg-ink"
          >
            Register an entry
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7" />
              <polyline points="7 7 17 7 17 17" />
            </svg>
          </a>
        </div>
        <img
          src="https://rsigeeks.com/blog/wp-content/uploads/2024/04/Visitor-Badge-Kiosk-Enhance-Security-and-Safety.jpg"
          alt="Security team ready to help"
          loading="lazy"
          class="reveal -mb-6 w-full self-end object-cover lg:w-[38%]"
        />
      </div>
    </div>
  </section>
</main>

<footer id="footer" class="px-[30px] pb-[30px] pt-[120px]">
  <div class="mx-auto flex w-full max-w-site flex-col gap-[61px]">
    <div class="flex flex-col items-start gap-16 lg:flex-row lg:gap-[160px]">
      <div class="flex w-full flex-col gap-10 lg:w-[331px]">
        <a href="#top" class="flex items-center gap-2.5" aria-label="Datem home">
          <img src="/images/datemlogo.png" width="42" alt="Datem logo" />
          <span class="text-h6 font-extrabold tracking-[-.02em]">Datem</span>
        </a>
        <p class="text-b16 opacity-80">
          Datem: Where Security Meets Smarter Access — your facility's
          digital guardian for visitor check-in and access management.
        </p>
      </div>

      <div class="flex w-full flex-col gap-12 sm:flex-row sm:gap-24 lg:justify-between">
        <div class="flex flex-col gap-[39px]">
          <p class="text-b20 font-semibold">Quick Links</p>
          <div class="flex flex-col gap-5">
            <a href="#top" class="text-b16 transition hover:text-brand">Home</a>
            <a href="#about" class="text-b16 transition hover:text-brand">Why Us</a>
            <a href="#services" class="text-b16 transition hover:text-brand">Services</a>
            <a href="#register" class="text-b16 transition hover:text-brand">Register Entry</a>
            <a href="https://gs1kenya.org/support?system=Datem" class="text-b16 transition hover:text-brand">Support</a>
          </div>
        </div>

        <div class="flex flex-col gap-[39px]">
          <p class="text-b20 font-semibold">Legal</p>
          <div class="flex flex-col gap-5">
            <a href="/terms" class="text-b16 transition hover:text-brand">Terms &amp; Conditions</a>
            <a href="/privacy_policy" class="text-b16 transition hover:text-brand">Privacy Policy</a>
          </div>
        </div>

        <div class="flex flex-col gap-[39px]" id="contact">
          <p class="text-b20 font-semibold">Contact Info</p>
          <div class="flex flex-col gap-6">
            <div class="flex gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
              <span class="text-b16">
                <span class="block font-semibold">Location</span>
                5th Floor Nextgen Mall, Mombasa Road, Nairobi, Kenya
              </span>
            </div>
            <div class="flex gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
              <span class="text-b16">
                <span class="block font-semibold">Phone Number</span>
                <a href="tel:+254709226000" class="transition hover:text-brand">+254 709 226 000</a>
              </span>
            </div>
            <div class="flex gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><polyline points="22 6 12 13 2 6" /></svg>
              <span class="text-b16">
                <span class="block font-semibold">Email</span>
                <a href="mailto:support@datem.co.ke" class="transition hover:text-brand">support@datem.co.ke</a>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-[#1b1e1e1a] pt-9 sm:flex-row">
      <p class="text-b16 opacity-80">
        © 2026 Powered by
        <a href="https://gs1kenya.org" rel="nofollow" class="font-semibold text-brand hover:underline">GS1 Kenya</a>.
        All Rights Reserved.
      </p>
      <a href="/privacy_policy" class="text-b16 transition hover:text-brand">Privacy Policy</a>
    </div>
  </div>
</footer>