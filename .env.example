# Copy this file to `.env` and fill in real values for local runs against
# a prod-like build. `mix phx.server` in dev does not read this file —
# it uses config/dev.exs. These are consumed via System.get_env in
# config/runtime.exs when MIX_ENV=prod (e.g. inside the release/Docker image).

DATABASE_URL=ecto://postgres:postgres@localhost/datem_prod
SECRET_KEY_BASE=
PHX_HOST=localhost
PORT=4000
POOL_SIZE=10
ECTO_IPV6=false
PHX_SERVER=true
EXPORTS_DIR=/data/exports
